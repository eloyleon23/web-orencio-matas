Options -Indexes
DirectoryIndex index.html

# Forzar HTTPS — bug real reportado: el sitio servía http:// y
# https:// como variantes independientes sin redirección entre
# ellas, y alguien accediendo por http:// desde datos móviles (una
# red donde la operadora puede interceptar/alterar tráfico sin
# cifrar) se encontraba el buscador sin productos, incluso en
# incógnito — mientras que https:// siempre cargaba bien. No toca
# DNS ni el panel de IONOS (a diferencia del redirect de variante
# de dominio www/sin-www, aparcado por el riesgo de su asistente
# automático sobre el registro MX del correo) — es solo una regla
# de Apache en este mismo .htaccess, sin ningún riesgo para el
# correo de la empresa.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Redirigir /defaultsite (y subpáginas antiguas indexadas) a la raíz
RedirectMatch 301 ^/defaultsite(/?.*)$ /$1

# Evitar que el navegador sirva una copia cacheada antigua de una
# página o de un catálogo tras un despliegue — bug real reportado:
# tras subir cambios a IONOS, Chrome (normal, no incógnito) seguía
# sirviendo una copia precargada de ANTES del despliegue a quien
# llegaba desde un enlace de resultados/ficha de Google (que activa
# la precarga predictiva de Chrome), mientras que incógnito y Safari
# cargaban bien la versión nueva — exactamente la diferencia que
# delata una caché local obsoleta, no un fallo de servidor. Como
# Apache no enviaba ninguna cabecera Cache-Control, el navegador
# decidía por heurística cuánto confiar en lo ya guardado. Con
# "no-cache" el navegador SIGUE pudiendo guardar la copia, pero
# está obligado a revalidarla con el servidor (ETag/Last-Modified)
# antes de usarla — así nunca se queda pegado a una versión
# anterior, y si no ha cambiado nada la revalidación es barata
# (304, sin volver a descargar el archivo entero).
<IfModule mod_headers.c>
    <FilesMatch "\.(html|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Comprimir las respuestas de texto (HTML/CSS/JS/JSON/SVG/fuentes de
# texto) con gzip — bug real detectado con pruebas de carga del
# buscador: IONOS no comprimía NADA (ni siquiera el CSS), a
# diferencia de GitHub Pages (preproducción), que sí lo hace por
# defecto. El caso más grave es data/productos.json: 4.4 MB tal
# cual, frente a ~540 KB comprimido (el mismo archivo, mismo
# contenido, en GitHub Pages) — un 88% menos. En una conexión
# móvil normal (~1.6 Mbps simulados) eso se traduce en muchos
# segundos de diferencia solo en esa descarga, antes de que el
# buscador pueda pintar ni un producto. Se aplica también al
# propio buscador.html (935 KB sin comprimir) y al resto de
# catálogos JSON (productos_talleres.json, etc.). Las imágenes de
# producto (ya comprimidas como JPEG/WEBP) no se ven afectadas ni
# falta que lo estén — mod_deflate no las toca.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/xml text/xml application/rss+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# Evita que un proxy/caché intermedio sirva la variante sin
# comprimir a un cliente que sí la admite (o viceversa) — depende
# de la cabecera Accept-Encoding de cada petición, así que cada
# variante debe cachearse por separado.
<IfModule mod_headers.c>
    <IfModule mod_deflate.c>
        Header append Vary Accept-Encoding
    </IfModule>
</IfModule>
